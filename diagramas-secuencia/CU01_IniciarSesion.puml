@startuml CU01_IniciarSesion
skinparam backgroundColor #FFFFFF
skinparam DefaultFontColor #000000
skinparam sequence {
    ArrowColor #000000
    ArrowFontSize 9
    LifeLineBorderColor #000000
    LifeLineBackgroundColor #FFFFFF
    ActorBorderColor #000000
    ActorBackgroundColor #FFFFFF
    ActorFontStyle normal
    ParticipantBorderColor #000000
    ParticipantBackgroundColor #FFFFFF
    ParticipantFontSize 10
    ParticipantFontStyle normal
}

title CU1. Iniciar sesión

actor Observador
participant LoginScreen <<View>>
participant AuthController <<Controller>>
participant Usuario <<Model>>

Observador -> LoginScreen : 1. IniciarSesion(email, password)
activate LoginScreen

LoginScreen -> AuthController : 1.1 POST /api/v1/auth/login(email, password)
activate AuthController

AuthController -> Usuario : 1.2 buscarPorEmail(email)
activate Usuario
deactivate Usuario

AuthController -> Usuario : 1.4 verificarPassword(password)
activate Usuario
deactivate Usuario

AuthController -> AuthController : 1.6 generarToken(usuarioId, email)

AuthController --> LoginScreen : 1.7 200 OK (token, usuarioId, email, nombreCompleto)
deactivate AuthController

LoginScreen --> Observador : 1.8 Sesión iniciada, ingresa al selector de proyectos
deactivate LoginScreen

@enduml
